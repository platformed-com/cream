{
  "$schema": "../static/jsonschema/core/schema.json",
  "schemas": ["urn:ietf:params:scim:schemas:core:2.0:Schema"],
  "id": "urn:ietf:params:scim:schemas:custom:2.0:UserExtension",
  "name": "UserExtension",
  "description": "User Account extension",
  "attributes": [
    {
      "name": "favoriteColor",
      "type": "string",
      "multiValued": false,
      "description": "Favorite color of the user",
      "required": true,
      "caseExact": false,
      "mutability": "readWrite",
      "returned": "default",
      "uniqueness": "server"
    },
    {
      "name": "favoriteNumber",
      "type": "integer",
      "multiValued": false,
      "description": "Favorite number of the user"
    }
  ]
}
